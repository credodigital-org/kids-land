# Django
SECRET_KEY=change-this-to-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Neon/Postgres — matches your other projects)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Frontend origin allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudflare R2 (S3-compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kidsland-media
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<your-r2-public-domain>
